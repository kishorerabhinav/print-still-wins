<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="io.github.kishorerabhinav.printstillwins.peach" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Animated sliced-peach chart: skin = print share, stone = e-book share. Peach/orange styles and re-ordering.</description>
    <author name="Abhinav KR" email="kishorerabhinav@users.noreply.github.com" organization="" website="https://kishorerabhinav.github.io/print-still-wins/"/>
    <min-api-version>1.4</min-api-version>
    <source-location>
      <url>https://kishorerabhinav.github.io/print-still-wins/extension/peach.html</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Sliced Peach Chart (D3)</text>
    </resource>
  </resources>
</manifest>
